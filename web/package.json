{
  "name": "policyguard-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser demo for PolicyGuard. Classifies log lines against a policy DFA, entirely in the page.",
  "scripts": {
    "predev": "node scripts/sync-fixtures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-fixtures.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "parity": "node --experimental-strip-types scripts/check-parity.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
